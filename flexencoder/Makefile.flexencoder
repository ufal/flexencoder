# flexencoder - multi-file build
# Usage: make -f Makefile.flexencoder [flexencoder]
# Or: make -f Makefile.flexencoder BINDIR=../Scripts
#
# Shell: a backslash must be the *last* character on the line (no spaces after it).
# Put #comments on their own line, not after BINDIR=... on a continued line.

MAKEFLAGS += -r
#
# Pando C++ API (direct indexing, no JSONL/subprocess):
#   make -f Makefile.flexencoder PANDO_SRC=/path/to/pando PANDO_BUILD=/path/to/pando/build
# PANDO_BUILD defaults to $(PANDO_SRC)/build.

CXX = g++
CXXFLAGS = -std=c++17 -O2 -I.
BINDIR = ../Scripts

FLEXENCODER_SRCS = flexencoder.cpp flexencoder_extractor.cpp flexencoder_cwb.cpp \
                   flexencoder_clickhouse.cpp flexencoder_pando.cpp flexencoder_xidx.cpp flexencoder_vrt.cpp \
                   flexencoder_makeall.cpp flexencoder_helpers.cpp pugixml.cpp functions-c11.cpp \
                   flexencoder_conllu.cpp flexencoder_conllu_comments.cpp flexencoder_misc_rules.cpp

# Optional: Pando index API (pando::PandoIndexBuilder)
ifdef PANDO_SRC
PANDO_BUILD ?= $(PANDO_SRC)/build
CXXFLAGS += -DUSE_PANDO_API -I$(PANDO_SRC)/src
FLEXENCODER_SRCS += flexencoder_pando_api.cpp
# pando_core uses its query-dialect libraries and, when Pando was built with RE2, RE2 (pkg-config re2)
PANDO_DIALECT_LIBS = $(foreach l,pando_cwb_dialect pando_pmltq_dialect pando_manatee_dialect,\
                       $(if $(wildcard $(PANDO_BUILD)/lib$(l).a),-l$(l)))
PANDO_RE2_LIBS ?= $(shell grep -q 'PANDO_WITH_RE2:INTERNAL=ON\|re2_DIR:PATH=/' $(PANDO_BUILD)/CMakeCache.txt 2>/dev/null && pkg-config --libs re2 2>/dev/null)
LDFLAGS_PANDO = -L$(PANDO_BUILD) -lpando_core $(PANDO_DIALECT_LIBS) $(PANDO_RE2_LIBS)
else
LDFLAGS_PANDO =
endif

FLEXENCODER_OBJS = $(FLEXENCODER_SRCS:.cpp=.o)

flexencoder: $(BINDIR)/flexencoder

$(BINDIR)/flexencoder: $(FLEXENCODER_OBJS)
	@mkdir -p $(BINDIR)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS_PANDO)

# -MMD -MP: each .o also depends on the headers it includes (a changed header,
# e.g. a new virtual in flexencoder.hpp, rebuilds every user instead of linking
# objects with mismatched layouts, which crashes at run time)
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

-include $(FLEXENCODER_OBJS:.o=.d)

clean:
	rm -f $(FLEXENCODER_OBJS) $(FLEXENCODER_OBJS:.o=.d) $(BINDIR)/flexencoder

.PHONY: flexencoder clean
