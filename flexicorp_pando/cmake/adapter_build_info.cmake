# Writes OUT (a header) with the adapter's build identity: VERSION plus `git describe --always --dirty` and the
# commit of SRC (the flexencoder checkout). Run on every build (target flexicorp_pando_build_info); OUT only changes
# when the identity does. pando's own identity comes from pando's build (core/build_info.h).
set(ENV{GIT_OPTIONAL_LOCKS} 0)
set(describe "${VERSION}")
set(commit "unknown")
find_program(GIT_EXE git)
if(GIT_EXE)
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} describe --tags --always --dirty
                    OUTPUT_VARIABLE d RESULT_VARIABLE r1 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(r1 EQUAL 0 AND NOT d STREQUAL "")
        set(describe "${d}")
    endif()
    execute_process(COMMAND ${GIT_EXE} -C ${SRC} rev-parse HEAD
                    OUTPUT_VARIABLE c RESULT_VARIABLE r2 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(r2 EQUAL 0 AND NOT c STREQUAL "")
        set(commit "${c}")
    endif()
endif()
file(WRITE "${OUT}.tmp" "// Generated by cmake/adapter_build_info.cmake — do not edit.
#pragma once
#define FLEXICORP_PANDO_VERSION \"${VERSION}\"
#define FLEXICORP_PANDO_DESCRIBE \"${describe}\"
#define FLEXICORP_PANDO_COMMIT \"${commit}\"
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
